rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Agent Idea Space stays server-only. The integrated My Portal UI calls a
    // Netlify Function with its Firebase ID token; the Function verifies the
    // login and accesses this database through the Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
