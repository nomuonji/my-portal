rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access for authenticated users to the 'memos' collection
    match /memos/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'ideas' collection
    match /ideas/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'tags' collection
    match /tags/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'keywords' collection
    match /keywords/{keywordId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'featureRequests' collection
    match /featureRequests/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}