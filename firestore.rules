rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Main portal data is available only to signed-in users.
    match /memos/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /ideas/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /tags/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /keywords/{keywordId} {
      allow read, write: if request.auth != null;
    }

    match /featureRequests/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /reading_list_urls/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /reading_list_youtube/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /projects/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /flashcards/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /decks/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /groups/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /stocks/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /stock_tags/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /hobbies/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /hobby_tags/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Agent Idea Space shares the user's existing My Portal login. MCP writes
    // these collections through the Admin SDK; the UI reads and manages them
    // directly once the user has already authenticated to My Portal.
    match /relations/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /runs/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /sources/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /evaluations/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /artifacts/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Long-running Context Store / Thinking Workspace.
    // Existing short-form boards stay independent; these are additive collections.
    match /spaces/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /profileFacts/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /decisions/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /opportunities/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
