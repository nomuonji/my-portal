rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access for authenticated users to the 'memos' collection
    match /memos/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'ideas' collection
    match /ideas/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'tags' collection
    match /tags/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'keywords' collection
    match /keywords/{keywordId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'featureRequests' collection
    match /featureRequests/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'reading_list_urls' collection
    match /reading_list_urls/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'reading_list_youtube' collection
    match /reading_list_youtube/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'projects' collection
    match /projects/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'flashcards' collection
    match /flashcards/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'decks' collection
    match /decks/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'groups' collection
    match /groups/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'stocks' collection
    match /stocks/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access for authenticated users to the 'stock_tags' collection
    match /stock_tags/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}