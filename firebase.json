{
  "firestore": [
    {
      "database": "(default)",
      "location": "asia-northeast1",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "agent-ideas",
      "location": "asia-northeast1",
      "rules": "firestore.agent-ideas.rules",
      "indexes": "firestore.agent-ideas.indexes.json"
    }
  ],
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "agentIdeasMcp",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/mcp/**",
        "function": {
          "functionId": "agentIdeasMcp",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/oauth/authorize",
        "function": {
          "functionId": "agentIdeasMcp",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/oauth/token",
        "function": {
          "functionId": "agentIdeasMcp",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "function": {
          "functionId": "agentIdeasMcp",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": {
          "functionId": "agentIdeasMcp",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ]
}
